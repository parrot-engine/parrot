; vim: ft=asm

.n64_rsp

.define VERTEX_BATCHES 3
.define VERTEX_COUNT (VERTEX_BATCHES * 8)

.org 0x1000
start:
	transform_loop:
		sll $t1, $t0, 4 ; 16 bytes aka 8 words
		lqv $v4[0], vertex_x($t1)
		lqv $v5[0], vertex_y($t1)
		lqv $v6[0], vertex_z($t1)

		vmudh $v7, $v4, $v0[0] ; x * m00_hi
		vmadm $v7, $v4, $v0[1] ; x * m00_lo
		vmadh $v7, $v5, $v0[2] ; y * m01_hi
		vmadm $v7, $v5, $v0[3] ; y * m01_lo
		vmadh $v7, $v6, $v0[4] ; z * m02_hi
		vmadm $v7, $v6, $v0[5] ; z * m02_lo
		vmadh $v7, $v31, $v0[6] ; 1 * m03_hi
		vmadm $v7, $v31, $v0[7] ; 1 * m03_lo
		vsar $v7, $v7, $v7[1]

		vmudh $v8, $v4, $v1[0]
		vmadm $v8, $v4, $v1[1]
		vmadh $v8, $v5, $v1[2]
		vmadm $v8, $v5, $v1[3]
		vmadh $v8, $v6, $v1[4]
		vmadm $v8, $v6, $v1[5]
		vmadh $v8, $v31, $v1[6]
		vmadm $v8, $v31, $v1[7]
		vsar $v8, $v8, $v8[1]

		vmudh $v9, $v4, $v2[0]
		vmadm $v9, $v4, $v2[1]
		vmadh $v9, $v5, $v2[2]
		vmadm $v9, $v5, $v2[3]
		vmadh $v9, $v6, $v2[4]
		vmadm $v9, $v6, $v2[5]
		vmadh $v9, $v31, $v2[6]
		vmadm $v9, $v31, $v2[7]
		vsar $v9, $v9, $v9[1]

		sqv $v7[0], vertex_x($t1)
		sqv $v8[0], vertex_y($t1)
		sqv $v9[0], vertex_z($t1)

		addi $t0, $t0, 1
		li $t1, VERTEX_BATCHES
		bne $t0, $t1, transform_loop
		nop

    nop
    break

one_q12_4: .dw 0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0010, 0x0010

.org 0x0000

matrix: .resb 4 * 4 * 4 ; ParrotFixed32s; accessed like matrix[x][y]

vertex_x: .resw VERTEX_COUNT ; ParrotFixed16i
vertex_y: .resw VERTEX_COUNT ; ParrotFixed16i
vertex_z: .resw VERTEX_COUNT ; ParrotFixed16i
vertex_u: .resw VERTEX_COUNT ; ParrotFixed16f
vertex_v: .resw VERTEX_COUNT ; ParrotFixed16f

color_rgba8888: .resb 4
